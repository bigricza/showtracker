rules_version = '2';

// Each signed-in user can only read and write their own shows.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/shows/{showId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validShow();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validShow() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'name', 'image', 'network', 'status', 'premiered', 'genres',
                               'officialSite', 'summary', 'rating', 'myLink', 'watched',
                               'addedAt', 'lastTouch'])
        && d.name is string && d.name.size() <= 300
        && d.watched is map
        && (!('myLink' in d) || d.myLink == null || (d.myLink is string && d.myLink.size() <= 2000))
        && (!('summary' in d) || d.summary == null || (d.summary is string && d.summary.size() <= 2000));
    }
  }
}
